[
  {
    "uid": "gal001-ratio", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "checkout",
    "title": "Checkout error ratio",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"checkout\",code=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"checkout\"}[5m]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.05
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "5m",
    "labels": {
      "severity": "page",
      "team": "checkout"
    },
    "annotations": {
      "summary": "Checkout fails more than 5% of requests",
      "runbook_url": "https://runbooks.example.com/checkout/errors"
    }
  },
