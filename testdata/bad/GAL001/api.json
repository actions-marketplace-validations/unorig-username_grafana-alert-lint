          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.1
                ],
                "type": "lt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
