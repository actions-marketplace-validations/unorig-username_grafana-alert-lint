  {
    "uid": "gal001-two-windows", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "checkout",
    "title": "Checkout error budget burn",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 3600,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"checkout\",code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"checkout\"}[1h])) > 0.0144\nand\nsum(rate(http_requests_total{service=\"checkout\",code=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"checkout\"}[5m])) > 0.0144\n",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "2m",
    "labels": {
      "severity": "page",
      "team": "checkout"
    },
    "annotations": {
      "summary": "Checkout is burning its error budget 14.4 times too fast",
      "runbook_url": "https://runbooks.example.com/checkout/slo"
    }
  },
