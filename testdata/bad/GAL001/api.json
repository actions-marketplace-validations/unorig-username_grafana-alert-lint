        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "min by (instance) (node_filesystem_avail_bytes{job=\"checkout\"} / node_filesystem_size_bytes{job=\"checkout\"})",
