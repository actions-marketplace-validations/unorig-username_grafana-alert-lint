[
  {
    "uid": "gal002-alerting", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API instance down",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "min by (instance) (up{job=\"api\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "lt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "Alerting",
    "execErrState": "Error",
    "for": "5m",
    "labels": {
      "severity": "page",
      "team": "api"
    },
    "annotations": {
      "summary": "An API instance is not being scraped",
      "runbook_url": "https://runbooks.example.com/api/down"
    }
  },
  {
    "uid": "gal002-ok", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API queue backlog",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(job_queue_depth{service=\"api\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1000
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "10m",
    "labels": {
      "severity": "ticket",
      "team": "api"
    },
    "annotations": {
      "summary": "The API job queue holds more than 1000 jobs",
      "runbook_url": "https://runbooks.example.com/api/queue"
    }
  },
