  {
    "uid": "gal002-keeplast", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API memory high",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "max by (pod) (container_memory_working_set_bytes{container=\"api\"} / container_spec_memory_limit_bytes{container=\"api\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.9
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "KeepLast",
    "execErrState": "KeepLast",
    "for": "15m",
    "labels": {
      "severity": "ticket",
      "team": "api"
    },
    "annotations": {
      "summary": "An API pod uses more than 90% of its memory limit",
      "runbook_url": "https://runbooks.example.com/api/memory"
    }
  }
]
