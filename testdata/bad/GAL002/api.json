          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "10m",
    "labels": {
      "severity": "ticket",
      "team": "api"
    },
    "annotations": {
      "summary": "The API job queue holds more than 1000 jobs",
