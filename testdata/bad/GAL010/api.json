  {
    "uid": "gal010-loki", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API panics in logs",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "loki",
        "model": {
          "expr": "sum(count_over_time({app=\"api\"} |= \"panic\" [5m]))",
          "queryType": "instant",
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "loki",
        "model": {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({app=\"api\"}[1m]))",
          "queryType": "instant",
          "refId": "B"
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "model": {
          "type": "math",
          "expression": "$A > 0 && $B > 1",
          "refId": "C"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "5m",
    "labels": {
      "severity": "ticket",
      "team": "api"
    },
    "annotations": {
      "summary": "The API logged a panic",
      "runbook_url": "https://runbooks.example.com/api/panics"
    }
  }
