[
  {
    "uid": "gal010-syntax", "record": null,
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API worker restarts",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{container=\"api\"}[15m])",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  3
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "5m",
    "labels": {
      "severity": "ticket",
      "team": "api"
    },
    "annotations": {
      "summary": "API containers restarted more than 3 times in 15 minutes",
      "runbook_url": "https://runbooks.example.com/api/restarts"
    }
  },
