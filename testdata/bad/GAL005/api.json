[
  {
    "uid": "gal005-short",
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API traffic dropped",
    "condition": "D",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[1m]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(increase(http_requests_total{service=\"api\"}[2m] offset 1h))",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[2m:1m]))",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      },
      {
        "refId": "D",
        "datasourceUid": "__expr__",
        "model": {
          "type": "math",
          "expression": "$A < 1 || $B < 60 || $C < 1",
          "refId": "D"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "10m",
    "labels": {
      "severity": "page",
      "team": "api"
    },
    "annotations": {
      "summary": "The API is serving almost no traffic",
      "runbook_url": "https://runbooks.example.com/api/traffic"
    }
  },
  {
    "uid": "gal005-ok",
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "api",
    "title": "API traffic dropped long windows",
    "condition": "E",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[5m] offset 1h))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 1800,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "max_over_time(sum(rate(http_requests_total{service=\"api\"}[5m]))[30m:1m])",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[$__rate_interval]))",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      },
      {
        "refId": "D",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum(rate(http_requests_total{service=\"api\"}[10m:])) + deriv(process_resident_memory_bytes{job=\"api\"}[1m]) * 0",
          "instant": true,
          "range": false,
          "refId": "D"
        }
      },
      {
        "refId": "E",
        "datasourceUid": "__expr__",
        "model": {
          "type": "math",
          "expression": "$A < 1 || $B < 1 || $C < 1 || $D < 1",
          "refId": "E"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "for": "10m",
    "labels": {
      "severity": "page",
      "team": "api"
    },
    "annotations": {
      "summary": "The API is serving almost no traffic",
      "runbook_url": "https://runbooks.example.com/api/traffic"
    }
  }
]
