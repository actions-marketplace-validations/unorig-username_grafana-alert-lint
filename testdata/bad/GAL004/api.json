[
  {
    "uid": "gal004-unset",
    "orgID": 1,
    "folderUID": "services",
    "ruleGroup": "checkout",
    "title": "Checkout cart service saturated",
    "condition": "B",
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "avg(worker_busy_ratio{service=\"cart\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "model": {
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.9
                ],
                "type": "gt"
              }
            }
          ],
          "refId": "B"
        }
      }
    ],
    "noDataState": "NoData",
    "execErrState": "Error",
    "labels": {
      "severity": "page",
      "team": "checkout"
    },
    "annotations": {
      "summary": "Cart workers are more than 90% busy",
